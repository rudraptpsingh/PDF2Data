{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:powerlex:legal-l1:source-manifest:v1",
  "title": "Powerlex offline L1 source manifest",
  "type": "object",
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"const": "powerlex.legal-l1.v1"},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "path", "sha256", "family"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "family": {"enum": ["regulation", "draft", "notice", "explanatory_memorandum", "judgment", "interim_order", "record_of_proceedings", "approval", "pleading", "registry_listing", "contract", "tender", "technical_procedure", "financial_evidence"]},
          "title": {"type": "string", "minLength": 1, "maxLength": 240},
          "url": {"type": ["string", "null"]},
          "expected_pages": {"type": "integer", "minimum": 1}
        }
      }
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "required_source_ids"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "required_source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
        }
      }
    }
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}},
  "$comment": "Runtime also enforces unique source/group IDs, URL safety, expected file hash and actual physical page count. A declared URL or family does not establish provenance or legal effect."
}

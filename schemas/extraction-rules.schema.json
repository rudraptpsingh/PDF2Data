{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PDF2Data configurable extraction rules",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "version",
    "fields"
  ],
  "properties": {
    "schema_version": {
      "const": "pdf2data.extraction-rules.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "families": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "enum": [
              "text",
              "reference",
              "date",
              "quantity",
              "formula"
            ]
          },
          "extractor": {
            "enum": [
              "regex",
              "formulas"
            ]
          },
          "pattern": {
            "type": "string",
            "maxLength": 2000
          },
          "flags": {
            "type": "array",
            "items": {
              "enum": [
                "IGNORECASE",
                "MULTILINE",
                "DOTALL"
              ]
            }
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "uniqueItems": true
          },
          "scope": {
            "enum": [
              "all",
              "body_candidate",
              "header_candidate",
              "footer_candidate",
              "native_unit_candidate"
            ]
          },
          "families": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "date_format": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "capture_groups": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
            }
          },
          "native_unit_ids": {
            "type": "array",
            "maxItems": 1000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "native_unit_labels": {
            "type": "array",
            "maxItems": 1000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "quantity_normalization": {
            "enum": [
              "english_cardinal_0_100_v1",
              "english_cardinal_percent_0_100_v1"
            ]
          }
        },
        "oneOf": [
          {
            "required": [
              "extractor"
            ],
            "properties": {
              "extractor": {
                "const": "formulas"
              },
              "type": {
                "const": "formula"
              }
            }
          },
          {
            "required": [
              "pattern"
            ],
            "properties": {
              "extractor": {
                "const": "regex"
              }
            }
          }
        ],
        "allOf": [
          {
            "if": {
              "required": [
                "quantity_normalization"
              ]
            },
            "then": {
              "properties": {
                "type": {
                  "const": "quantity"
                }
              }
            }
          }
        ]
      }
    },
    "fields_schema_version": {
      "enum": [
        "pdf2data.configured-fields.v1",
        "pdf2data.configured-fields.v2",
        "pdf2data.configured-fields.v3"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "fields": {
            "contains": {
              "required": [
                "capture_groups"
              ]
            }
          }
        }
      },
      "then": {
        "required": [
          "fields_schema_version"
        ],
        "properties": {
          "fields_schema_version": {
            "enum": [
              "pdf2data.configured-fields.v2",
              "pdf2data.configured-fields.v3"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "fields_schema_version"
        ],
        "properties": {
          "fields_schema_version": {
            "const": "pdf2data.configured-fields.v3"
          }
        }
      },
      "then": {
        "properties": {
          "fields": {
            "items": {
              "required": [
                "scope",
                "pattern"
              ],
              "properties": {
                "scope": {
                  "const": "native_unit_candidate"
                },
                "extractor": {
                  "const": "regex"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "fields": {
            "items": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "native_unit_ids"
                    ]
                  },
                  {
                    "required": [
                      "native_unit_labels"
                    ]
                  },
                  {
                    "required": [
                      "scope"
                    ],
                    "properties": {
                      "scope": {
                        "const": "native_unit_candidate"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}

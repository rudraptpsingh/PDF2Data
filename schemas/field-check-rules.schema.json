{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PDF2Data field check rules v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "target", "checks"],
  "properties": {
    "schema_version": {"const": "pdf2data.field-check-rules.v1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 200},
    "version": {"type": "string", "minLength": 1, "maxLength": 200},
    "target": {
      "type": "object", "additionalProperties": false, "required": ["rules_sha256"],
      "properties": {
        "rules_sha256": {"$ref": "#/$defs/sha256"},
        "source_pdf_sha256": {"$ref": "#/$defs/sha256"},
        "source_package_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "checks": {
      "type": "array", "minItems": 1, "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "field_id", "count"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "field_id": {"$ref": "#/$defs/id"},
          "count": {
            "type": "object", "additionalProperties": false, "required": ["min", "max"],
            "properties": {
              "min": {"type": "integer", "minimum": 0, "maximum": 10000},
              "max": {"type": "integer", "minimum": 0, "maximum": 10000}
            }
          },
          "expected_literals": {"$ref": "#/$defs/strings"},
          "forbidden_fragments": {"$ref": "#/$defs/strings"},
          "required_captures": {"allOf": [{"$ref": "#/$defs/strings"}], "uniqueItems": true},
          "expected_pages": {
            "type": "array", "minItems": 1, "maxItems": 1000,
            "items": {"type": "array", "minItems": 1, "maxItems": 10000,
                      "items": {"type": "integer", "minimum": 1}}
          },
          "expected_typed_candidates": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "numerator",
                    "denominator"
                  ],
                  "properties": {
                    "numerator": {
                      "type": "string",
                      "pattern": "^-?(?:0|[1-9][0-9]{0,199})$"
                    },
                    "denominator": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]{0,199}$"
                    }
                  }
                }
              ]
            }
          },
          "expected_captures": {
            "type": "array", "minItems": 1, "maxItems": 1000,
            "items": {
              "type": "object", "minProperties": 1, "maxProperties": 32,
              "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"},
              "additionalProperties": {"type": ["string", "null"], "maxLength": 100000}
            }
          }
        },
        "allOf": [{
          "if": {"anyOf": [
            {"required": ["expected_literals"]}, {"required": ["expected_pages"]},
            {"required": ["expected_captures"]}, {"required": ["required_captures"]},
            {"required": ["forbidden_fragments"]}, {"required": ["expected_typed_candidates"]}
          ]},
          "then": {"properties": {"count": {"properties": {"min": {"minimum": 1}}}}}
        }]
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "strings": {"type": "array", "minItems": 1, "maxItems": 1000,
                "items": {"type": "string", "minLength": 1, "maxLength": 100000}}
  }
}

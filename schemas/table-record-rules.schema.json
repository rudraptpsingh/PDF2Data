{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "version",
    "table_ids",
    "roles",
    "levels"
  ],
  "properties": {
    "schema_version": {
      "const": "pdf2data.table-record-rules.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "table_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000
      }
    },
    "column_maps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "header_rows": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "marker_roles"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "marker_roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "match": {
            "enum": [
              "any",
              "all"
            ]
          }
        }
      }
    },
    "period_roles": {
      "type": "object",
      "required": [
        "start",
        "end",
        "days",
        "charge"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "minProperties": 4,
      "maxProperties": 4
    },
    "summary_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary_level": {
      "type": "string",
      "minLength": 1
    },
    "status_literals": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "max_rows": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "max_cells": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    }
  }
}

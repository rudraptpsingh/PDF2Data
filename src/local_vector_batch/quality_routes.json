    {"id": "ocr_coordinates", "reasons": ["ocr_line_box_invalid", "ocr_line_boxes_missing"], "execution": "awaiting_evidence", "action": "repair_source_bound_ocr_geometry"},
    {"id": "verified_text_visual_gap", "all_pass": ["language", "words_and_order", "ordered_numbers", "ordered_operators"], "execution": "awaiting_evidence", "action": "resolve_layout_or_visual_regions_without_repeating_text_ocr"},
    {"id": "numbers_or_logic", "failed": ["ordered_numbers", "ordered_operators"], "execution": "ocr_text", "action": "compare_source_numbers_units_and_column_semantics"},

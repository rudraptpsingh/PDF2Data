{
  "schema_version": 1,
  "word_recall_min": 0.98,
  "word_precision_min": 0.98,
  "word_order_min": 0.98,
  "source_ink_unaccounted_max": 0,
  "source_dark_pixel_threshold": 100,
  "source_edge_exclusion_px": 2,
  "ocr_box_padding_px": 3,
  "ocr_box_max_normalized_overhang": 0.01,
  "source_speck_max_pixels": 9,
  "footer_rule_min_width_fraction": 0.25,
  "footer_rule_max_height_fraction": 0.01,
  "footer_rule_min_aspect": 20,
  "header_rule_max_bottom_fraction": 0.08,
